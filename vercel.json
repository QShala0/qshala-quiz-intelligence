{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/media/:path*",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/api/:path*",
      "destination": "https://qshala-quiz-intelligence-238470261844.asia-southeast1.run.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://qshala-quiz-intelligence-238470261844.asia-southeast1.run.app/health"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
