+name: Nightly vault backup
+
+# Dumps the production database to a PRIVATE R2 bucket every night (30 daily + 12 monthly kept) and fails loudly if
+# anything goes wrong. Setup: docs/BACKUPS.md. It needs these repository secrets:
+#   DATABASE_URL, R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, BACKUP_R2_BUCKET
+on:
+  schedule:
+    - cron: "30 21 * * *"          # 03:00 IST
+  workflow_dispatch: {}
+
+concurrency:
+  group: vault-backup
+  cancel-in-progress: false
+
+jobs:
+  backup:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 60
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+      - name: Install a pg_dump at least as new as the database
+        run: |
+          sudo install -d /usr/share/postgresql-common/pgdg
+          sudo curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc
+          echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt noble-pgdg main" | sudo tee /etc/apt/sources.list.d/pgdg.list
+          sudo apt-get update -qq
+          sudo apt-get install -y -qq postgresql-client-17
+          pg_dump --version
+      - name: Install backup dependencies
+        run: pip install -r backend/requirements.lock.txt
+      - name: Check the backup plan
+        env:
+          DATABASE_URL: ${{ secrets.DATABASE_URL }}
+          R2_ACCOUNT_ID: ${{ secrets.R2_ACCOUNT_ID }}
+          R2_ACCESS_KEY_ID: ${{ secrets.R2_ACCESS_KEY_ID }}
+          R2_SECRET_ACCESS_KEY: ${{ secrets.R2_SECRET_ACCESS_KEY }}
+          BACKUP_R2_BUCKET: ${{ secrets.BACKUP_R2_BUCKET }}
+        run: python backend/scripts/backup_vault.py --dry-run
+      - name: Back up
+        env:
+          DATABASE_URL: ${{ secrets.DATABASE_URL }}
+          R2_ACCOUNT_ID: ${{ secrets.R2_ACCOUNT_ID }}
+          R2_ACCESS_KEY_ID: ${{ secrets.R2_ACCESS_KEY_ID }}
+          R2_SECRET_ACCESS_KEY: ${{ secrets.R2_SECRET_ACCESS_KEY }}
+          BACKUP_R2_BUCKET: ${{ secrets.BACKUP_R2_BUCKET }}
+        run: python backend/scripts/backup_vault.py
diff --git a/deploy/cloudbuild.yaml b/deploy/cloudbuild.yaml
new file mode 100644
index 0000000..9a4ebeb
--- /dev/null
+++ b/deploy/cloudbuild.yaml
@@ -0,0 +1,50 @@
+# Test-gated deploy for the API. Replaces the console's "Continuously deploy from source repository" trigger:
+# the backend tests run first, and the image is built and deployed only if they pass. Images are tagged with the
+# commit, so rolling back is one command (see docs/DEPLOY.md).
+#
+# Point a Cloud Build trigger (push to main) at THIS file, then disable the old source-deploy trigger.
+# [verify] the substitution defaults below against your project before the first run.
+substitutions:
+  _SERVICE: qshala-quiz-intelligence
+  _JOB: qshala-ingestion-worker
+  _REGION: asia-south1
+  _REPO: cloud-run-source-deploy        # Artifact Registry repository the console source-deploy used
+
+steps:
+  - id: tests
+    name: 'python:3.12-slim'
+    entrypoint: bash
+    args:
+      - -c
+      - |
+        set -euo pipefail
+        pip install --quiet -r backend/requirements-dev.lock.txt
+        python -m pytest backend/tests -q -p no:cacheprovider
+
+  - id: build
+    name: 'gcr.io/cloud-builders/docker'
+    args: ['build', '-t', '${_REGION}-docker.pkg.dev/$PROJECT_ID/${_REPO}/${_SERVICE}:$COMMIT_SHA', '.']
+
+  - id: push
+    name: 'gcr.io/cloud-builders/docker'
+    args: ['push', '${_REGION}-docker.pkg.dev/$PROJECT_ID/${_REPO}/${_SERVICE}:$COMMIT_SHA']
+
+  # Only the image changes; every other setting (env vars, secrets, memory, instances) stays as configured on the service.
+  - id: deploy-service
+    name: 'gcr.io/google.com/cloudsdktool/cloud-sdk:slim'
+    entrypoint: gcloud
+    args: ['run', 'deploy', '${_SERVICE}', '--region=${_REGION}',
+           '--image=${_REGION}-docker.pkg.dev/$PROJECT_ID/${_REPO}/${_SERVICE}:$COMMIT_SHA', '--quiet']
+
+  - id: update-worker-job
+    name: 'gcr.io/google.com/cloudsdktool/cloud-sdk:slim'
+    entrypoint: gcloud
+    args: ['run', 'jobs', 'update', '${_JOB}', '--region=${_REGION}',
+           '--image=${_REGION}-docker.pkg.dev/$PROJECT_ID/${_REPO}/${_SERVICE}:$COMMIT_SHA', '--quiet']
+
+images:
+  - '${_REGION}-docker.pkg.dev/$PROJECT_ID/${_REPO}/${_SERVICE}:$COMMIT_SHA'
+
+timeout: 1800s
+options:
+  logging: CLOUD_LOGGING_ONLY
diff --git a/deploy/export_cloudrun_settings.sh b/deploy/export_cloudrun_settings.sh
new file mode 100755
index 0000000..daaf5bd
--- /dev/null
+++ b/deploy/export_cloudrun_settings.sh
@@ -0,0 +1,14 @@
+#!/usr/bin/env bash
+# Writes the LIVE Cloud Run settings (service and worker job) into deploy/ so they are versioned and reviewable.
+# Run it from a machine logged in to gcloud, review the files for secrets, then commit them.
+# Secrets configured through Secret Manager appear only as references; plain-text env vars appear as values, so
+# check the output before committing and move anything sensitive to Secret Manager.
+set -euo pipefail
+SERVICE="${SERVICE:-qshala-quiz-intelligence}"
+JOB="${JOB:-qshala-ingestion-worker}"
+REGION="${REGION:-asia-south1}"
+cd "$(dirname "$0")"
+gcloud run services describe "$SERVICE" --region="$REGION" --format=export > cloudrun-service.live.yaml
+gcloud run jobs describe "$JOB" --region="$REGION" --format=export > cloudrun-job.live.yaml
+echo "Wrote deploy/cloudrun-service.live.yaml and deploy/cloudrun-job.live.yaml - review for secrets, then commit."
+grep -nE "maxScale|minScale|memory:|cpu:|containerConcurrency|timeoutSeconds" cloudrun-service.live.yaml || true
