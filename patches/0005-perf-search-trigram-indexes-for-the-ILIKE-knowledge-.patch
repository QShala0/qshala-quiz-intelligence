+"""Trigram GIN indexes for the ILIKE '%text%' knowledge-base filters (Postgres only; no effect on results).
+
+Live databases: prefer `python backend/scripts/add_search_indexes.py --apply`, which builds CONCURRENTLY.
+
+Revision ID: 0008_search_trigram_indexes
+Revises: 0007_usage_tracking
+Create Date: 2026-11-12
+"""
+from typing import Sequence, Union
+from alembic import op
+
+revision: str = "0008_search_trigram_indexes"
+down_revision: Union[str, None] = "0007_usage_tracking"
+branch_labels: Union[str, Sequence[str], None] = None
+depends_on: Union[str, Sequence[str], None] = None
+
+INDEXES = [
+    ("ix_questions_topic_trgm", "questions", "topic gin_trgm_ops"),
+    ("ix_questions_subtopic_trgm", "questions", "subtopic gin_trgm_ops"),
+    ("ix_questions_tags_text_trgm", "questions", "(CAST(tags AS VARCHAR)) gin_trgm_ops"),
+    ("ix_documents_title_trgm", "documents", "title gin_trgm_ops"),
+]
+
+
+def upgrade() -> None:
+    if op.get_bind().dialect.name != "postgresql":
+        return
+    op.execute("CREATE EXTENSION IF NOT EXISTS pg_trgm")
+    for name, table, expr in INDEXES:
+        op.execute(f"CREATE INDEX IF NOT EXISTS {name} ON {table} USING gin ({expr})")
+
+
+def downgrade() -> None:
+    if op.get_bind().dialect.name != "postgresql":
+        return
+    for name, _t, _e in INDEXES:
+        op.execute(f"DROP INDEX IF EXISTS {name}")
diff --git a/backend/scripts/add_search_indexes.py b/backend/scripts/add_search_indexes.py
new file mode 100644
index 0000000..0851263
--- /dev/null
+++ b/backend/scripts/add_search_indexes.py
@@ -0,0 +1,46 @@
+"""Add trigram (pg_trgm) GIN indexes so the knowledge-base filters that use ILIKE '%text%' stop scanning every row.
+
+    python backend/scripts/add_search_indexes.py            # dry run: prints what it would do
+    python backend/scripts/add_search_indexes.py --apply    # CREATE INDEX CONCURRENTLY (does not block reads or writes)
+
+Indexes change how a row is found, never which rows match, so API output is unchanged. Postgres only; needs
+permission to CREATE EXTENSION pg_trgm (allowed on Neon). Safe to re-run (IF NOT EXISTS). Alembic revision
+0008_search_trigram_indexes does the same for environments that run migrations.
+"""
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+# (index name, table, expression). The tags expression must match the query's CAST(questions.tags AS VARCHAR).
+INDEXES = [
+    ("ix_questions_topic_trgm", "questions", "topic gin_trgm_ops"),
+    ("ix_questions_subtopic_trgm", "questions", "subtopic gin_trgm_ops"),
+    ("ix_questions_tags_text_trgm", "questions", "(CAST(tags AS VARCHAR)) gin_trgm_ops"),
+    ("ix_documents_title_trgm", "documents", "title gin_trgm_ops"),
+]
+
+
+def statements():
+    yield "CREATE EXTENSION IF NOT EXISTS pg_trgm"
+    for name, table, expr in INDEXES:
+        yield f"CREATE INDEX CONCURRENTLY IF NOT EXISTS {name} ON {table} USING gin ({expr})"
+
+
+def main() -> int:
+    from backend.app.database import engine
+    if engine.dialect.name != "postgresql":
+        print("Postgres only; nothing to do on", engine.dialect.name)
+        return 0
+    apply = "--apply" in sys.argv
+    with engine.connect().execution_options(isolation_level="AUTOCOMMIT") as conn:
+        for sql in statements():
+            print(("APPLY  " if apply else "DRY    ") + sql)
+            if apply:
+                conn.exec_driver_sql(sql)
+    print("done" if apply else "dry run only; re-run with --apply")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/backend/tests/test_search_indexes.py b/backend/tests/test_search_indexes.py
new file mode 100644
index 0000000..e3b69c1
--- /dev/null
+++ b/backend/tests/test_search_indexes.py
@@ -0,0 +1,39 @@
+"""The trigram index definitions must stay in sync with each other and with the SQL the search endpoint generates."""
+import importlib.util
+import sys
+from pathlib import Path
+
+from sqlalchemy import String, func
+from sqlalchemy.dialects import postgresql
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def _load(path, name):
+    spec = importlib.util.spec_from_file_location(name, path)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[name] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def test_script_and_migration_define_the_same_indexes():
+    script = _load(ROOT / "backend/scripts/add_search_indexes.py", "add_search_indexes")
+    mig = _load(ROOT / "backend/alembic/versions/0008_search_trigram_indexes.py", "mig0008")
+    assert script.INDEXES == mig.INDEXES
+    assert mig.down_revision == "0007_usage_tracking"
+
+
+def test_tags_index_expression_matches_the_query_expression():
+    from backend.app.models.question import Question
+    sql = str(func.cast(Question.tags, String).ilike("%x%").compile(dialect=postgresql.dialect()))
+    assert "CAST(questions.tags AS VARCHAR)" in sql
+    script = _load(ROOT / "backend/scripts/add_search_indexes.py", "add_search_indexes2")
+    assert any("CAST(tags AS VARCHAR)" in expr for _n, _t, expr in script.INDEXES)
+
+
+def test_statements_are_idempotent_and_concurrent():
+    script = _load(ROOT / "backend/scripts/add_search_indexes.py", "add_search_indexes3")
+    stmts = list(script.statements())
+    assert stmts[0].startswith("CREATE EXTENSION IF NOT EXISTS pg_trgm")
+    assert all("CONCURRENTLY IF NOT EXISTS" in s for s in stmts[1:])
