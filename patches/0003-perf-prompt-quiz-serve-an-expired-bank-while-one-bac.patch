From e8ffd948f63e53ba1dbd277888c69e40e2740286 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 12 Nov 2026 07:58:28 +0000
Subject: [PATCH 3/9] perf(prompt-quiz): serve an expired bank while one
 background thread refreshes it

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 backend/app/services/prompt_quiz/engine.py | 96 ++++++++++++++++++----
 backend/tests/test_prompt_quiz_bank.py     | 78 ++++++++++++++++++
 2 files changed, 160 insertions(+), 14 deletions(-)

diff --git a/backend/app/services/prompt_quiz/engine.py b/backend/app/services/prompt_quiz/engine.py
index 6a84b99..4dac2c2 100644
--- a/backend/app/services/prompt_quiz/engine.py
+++ b/backend/app/services/prompt_quiz/engine.py
@@ -19,6 +19,7 @@ import logging
 logger = logging.getLogger(__name__)
 import os
 import re
+import threading
 import time
 from functools import lru_cache
 from dataclasses import dataclass, field, asdict
@@ -387,6 +388,9 @@ def interpret(prompt: str, count: Optional[int] = None, options: Optional[Dict[s
 # The bank is rebuilt from the database on every request (2-3 times per request in places). A short cache lets those
 # share one load. PROMPT_QUIZ_BANK_TTL_S=0 turns it off; questions added or edited show up within that many seconds.
 _BANK_CACHE: Dict[str, Any] = {"at": 0.0, "key": None, "bank": None, "index": None}
+_CACHE_LOCK = threading.Lock()          # guards every read/write of _BANK_CACHE so a refresh can never be seen half-done
+_REFRESH_LOCK = threading.Lock()        # held while one background refresh runs (single-flight)
+_REFRESH_FAILED_AT = 0.0
 
 
 class _BankList(list):
@@ -401,24 +405,80 @@ def _bank_ttl() -> float:
         return 10.0
 
 
+def _bank_stale_window() -> float:
+    """Seconds past the TTL during which an expired bank is still served while one background thread refreshes it, so no
+    request has to wait for a reload. 0 turns this off (an expired bank is then reloaded inside the request, as before)."""
+    try:
+        return max(0.0, float(os.getenv("PROMPT_QUIZ_BANK_STALE_S", "300")))
+    except ValueError:
+        return 300.0
+
+
 def invalidate_bank_cache() -> None:
-    _BANK_CACHE.update({"at": 0.0, "key": None, "bank": None, "index": None})
+    with _CACHE_LOCK:
+        _BANK_CACHE.update({"at": 0.0, "key": None, "bank": None, "index": None})
+
+
+def _cache_snapshot():
+    with _CACHE_LOCK:
+        return _BANK_CACHE["at"], _BANK_CACHE["key"], _BANK_CACHE["bank"]
+
+
+def _store_bank(at: float, key: Optional[str], bank: List[Dict[str, Any]]) -> None:
+    with _CACHE_LOCK:
+        _BANK_CACHE.update({"at": at, "key": key, "bank": bank, "index": None})
+
+
+def _copy_of(bank: List[Dict[str, Any]], token: float) -> "_BankList":
+    copy = _BankList(dict(r) for r in bank)      # callers may add fields (e.g. score) to what they get
+    copy.token = token
+    return copy
+
+
+def _refresh_bank_in_background(key: Optional[str]) -> None:
+    global _REFRESH_FAILED_AT
+    if time.monotonic() - _REFRESH_FAILED_AT < 10.0 or not _REFRESH_LOCK.acquire(blocking=False):
+        return
+
+    def run() -> None:
+        global _REFRESH_FAILED_AT
+        try:
+            from backend.app.database import SessionLocal
+            sess = SessionLocal()
+            try:
+                bank = _load_bank_uncached(sess)
+            finally:
+                sess.close()
+            _store_bank(time.monotonic(), key, bank)
+        except Exception as e:
+            _REFRESH_FAILED_AT = time.monotonic()
+            logger.warning("Background bank refresh failed (%s); still serving the previous bank", e)
+        finally:
+            _REFRESH_LOCK.release()
+
+    try:
+        threading.Thread(target=run, name="bank-refresh", daemon=True).start()
+    except Exception:
+        _REFRESH_LOCK.release()
 
 
 def _load_bank(db: Session) -> List[Dict[str, Any]]:
     ttl = _bank_ttl()
     key = str(db.get_bind().url) if ttl > 0 else None
     now = time.monotonic()
-    if ttl > 0 and _BANK_CACHE["bank"] is not None and _BANK_CACHE["key"] == key and now - _BANK_CACHE["at"] < ttl:
-        copy = _BankList(dict(r) for r in _BANK_CACHE["bank"])      # callers may add fields (e.g. score) to what they get
-        copy.token = _BANK_CACHE["at"]
-        return copy
+    if ttl > 0:
+        at, cached_key, cached = _cache_snapshot()
+        if cached is not None and cached_key == key:
+            age = now - at
+            if age < ttl:
+                return _copy_of(cached, at)
+            if age < ttl + _bank_stale_window():
+                _refresh_bank_in_background(key)
+                return _copy_of(cached, at)
     bank = _load_bank_uncached(db)
     if ttl > 0:
-        _BANK_CACHE.update({"at": now, "key": key, "bank": bank, "index": None})
-        copy = _BankList(dict(r) for r in bank)
-        copy.token = now
-        return copy
+        _store_bank(now, key, bank)
+        return _copy_of(bank, now)
     return bank
 
 
@@ -426,11 +486,19 @@ def _index_for(bank: List[Dict[str, Any]]) -> Index:
     """The search index for a bank. A bank straight from _load_bank shares one index per cache load (built from the
     untouched cached rows, never from a caller's copy); anything else gets a fresh index, as before."""
     tok = getattr(bank, "token", None)
-    if tok is not None and _BANK_CACHE["bank"] is not None and _BANK_CACHE["at"] == tok:
-        idx = _BANK_CACHE["index"]
-        if idx is None:
-            idx = _BANK_CACHE["index"] = Index(_BANK_CACHE["bank"])
-        return idx
+    if tok is not None:
+        with _CACHE_LOCK:
+            if _BANK_CACHE["bank"] is not None and _BANK_CACHE["at"] == tok:
+                idx, source = _BANK_CACHE["index"], _BANK_CACHE["bank"]
+            else:
+                idx = source = None
+        if source is not None:
+            if idx is None:
+                idx = Index(source)
+                with _CACHE_LOCK:
+                    if _BANK_CACHE["at"] == tok:
+                        _BANK_CACHE["index"] = idx
+            return idx
     return Index(bank)
 
 
diff --git a/backend/tests/test_prompt_quiz_bank.py b/backend/tests/test_prompt_quiz_bank.py
index 73582a5..768cde1 100644
--- a/backend/tests/test_prompt_quiz_bank.py
+++ b/backend/tests/test_prompt_quiz_bank.py
@@ -178,3 +178,81 @@ def test_deferring_unused_columns_does_not_change_the_bank(monkeypatch):
     finally:
         db.close()
     assert with_defer and with_defer == without
+
+
+def test_expired_bank_is_served_while_one_background_refresh_runs(monkeypatch):
+    import threading
+    import time as _t
+    monkeypatch.setenv("PROMPT_QUIZ_BANK_TTL_S", "1")
+    monkeypatch.setenv("PROMPT_QUIZ_BANK_STALE_S", "60")
+    engine.invalidate_bank_cache()
+    gate, calls = threading.Event(), []
+
+    def loader(db):
+        calls.append(1)
+        if len(calls) > 1:
+            gate.wait(5)
+        return [{"id": f"v{len(calls)}", "question_text": "t"}]
+
+    monkeypatch.setattr(engine, "_load_bank_uncached", loader)
+    db = SessionLocal()
+    try:
+        assert engine._load_bank(db)[0]["id"] == "v1"
+        _t.sleep(1.1)                                              # past the TTL, inside the stale window
+        for _ in range(3):
+            assert engine._load_bank(db)[0]["id"] == "v1"          # served at once, never waits for the reload
+        assert len(calls) <= 2                                     # many requests, a single background reload
+        gate.set()
+        for _ in range(100):
+            if engine._load_bank(db)[0]["id"] == "v2":
+                break
+            _t.sleep(0.05)
+        assert engine._load_bank(db)[0]["id"] == "v2" and len(calls) == 2
+    finally:
+        gate.set()
+        engine.invalidate_bank_cache()
+        db.close()
+
+
+def test_failed_background_refresh_keeps_serving_the_old_bank(monkeypatch):
+    import time as _t
+    monkeypatch.setenv("PROMPT_QUIZ_BANK_TTL_S", "1")
+    monkeypatch.setenv("PROMPT_QUIZ_BANK_STALE_S", "60")
+    engine.invalidate_bank_cache()
+    state = {"n": 0}
+
+    def loader(db):
+        state["n"] += 1
+        if state["n"] > 1:
+            raise RuntimeError("database blip")
+        return [{"id": "old", "question_text": "t"}]
+
+    monkeypatch.setattr(engine, "_load_bank_uncached", loader)
+    monkeypatch.setattr(engine, "_REFRESH_FAILED_AT", 0.0)
+    db = SessionLocal()
+    try:
+        engine._load_bank(db)
+        _t.sleep(1.1)
+        assert engine._load_bank(db)[0]["id"] == "old"
+        _t.sleep(0.3)
+        assert engine._load_bank(db)[0]["id"] == "old"
+    finally:
+        engine.invalidate_bank_cache()
+        db.close()
+
+
+def test_stale_window_zero_reloads_inside_the_request_as_before(monkeypatch):
+    import time as _t
+    monkeypatch.setenv("PROMPT_QUIZ_BANK_TTL_S", "1")
+    monkeypatch.setenv("PROMPT_QUIZ_BANK_STALE_S", "0")
+    engine.invalidate_bank_cache()
+    calls = []
+    monkeypatch.setattr(engine, "_load_bank_uncached", lambda db: calls.append(1) or [{"id": str(len(calls)), "question_text": "t"}])
+    db = SessionLocal()
+    try:
+        engine._load_bank(db)
+        _t.sleep(1.1)
+        assert engine._load_bank(db)[0]["id"] == "2"
+    finally:
+        engine.invalidate_bank_cache()
+        db.close()
