From 333d392a04a8f37f092f5570bd17e144aebc8f13 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 12 Nov 2026 07:57:28 +0000
Subject: [PATCH 2/9] perf(prompt-quiz): do not fetch bank columns the loader
 never reads

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 backend/app/services/prompt_quiz/engine.py | 10 ++++++-
 backend/tests/test_prompt_quiz_bank.py     | 33 ++++++++++++++++++++++
 2 files changed, 42 insertions(+), 1 deletion(-)

diff --git a/backend/app/services/prompt_quiz/engine.py b/backend/app/services/prompt_quiz/engine.py
index 6c0415c..6a84b99 100644
--- a/backend/app/services/prompt_quiz/engine.py
+++ b/backend/app/services/prompt_quiz/engine.py
@@ -447,9 +447,17 @@ def _latest_tags(db: Session) -> Dict[str, Any]:
     return {r.question_id: r for r in rows}
 
 
+_BANK_UNUSED_COLUMNS = ("options", "explanation", "audio_transcript", "video_transcript", "raw_media_refs",
+                        "visual_clues", "provenance_decks")
+
+
 def _load_bank_uncached(db: Session) -> List[Dict[str, Any]]:
     # The 768-number embedding vector is never read here; leaving it out roughly halves what is fetched per row.
-    qs = (db.query(Question).options(defer(Question.embedding), defer(Question.embedding_model))
+    # Nor are the long text/JSON columns below: the bank dict built further down reads none of them. If you start
+    # reading one, take it out of this list, otherwise it is fetched row by row (one query per question).
+    qs = (db.query(Question).options(
+              defer(Question.embedding), defer(Question.embedding_model),
+              *(defer(getattr(Question, c)) for c in _BANK_UNUSED_COLUMNS))
           .filter((Question.duplicate_status != "CONFIRMED_DUPLICATE") | (Question.duplicate_status.is_(None))).all())
     tags: Dict[str, Any] = {}
     try:
diff --git a/backend/tests/test_prompt_quiz_bank.py b/backend/tests/test_prompt_quiz_bank.py
index d55419d..73582a5 100644
--- a/backend/tests/test_prompt_quiz_bank.py
+++ b/backend/tests/test_prompt_quiz_bank.py
@@ -145,3 +145,36 @@ def test_bank_query_does_not_fetch_the_embedding_column():
         db.close()
     assert seen and all("questions.embedding," not in s and "questions.embedding " not in s.replace("embedding_model", "")
                         for s in seen)
+
+
+def test_bank_query_skips_unused_heavy_columns_and_never_lazy_loads_them():
+    from sqlalchemy import event
+    from backend.app.database import engine as db_engine
+    seen = []
+
+    def grab(conn, cursor, statement, *a):
+        if "FROM questions" in statement:
+            seen.append(statement)
+
+    event.listen(db_engine, "before_cursor_execute", grab)
+    db = SessionLocal()
+    try:
+        bank = engine._load_bank_uncached(db)
+    finally:
+        event.remove(db_engine, "before_cursor_execute", grab)
+        db.close()
+    assert bank, "needs at least one question in the test database"
+    for col in engine._BANK_UNUSED_COLUMNS:
+        assert all(f"questions.{col}," not in s and f"questions.{col} " not in s for s in seen), col
+    assert len(seen) == 1, "a deferred column was read, which fetches it one row at a time"
+
+
+def test_deferring_unused_columns_does_not_change_the_bank(monkeypatch):
+    db = SessionLocal()
+    try:
+        with_defer = engine._load_bank_uncached(db)
+        monkeypatch.setattr(engine, "_BANK_UNUSED_COLUMNS", ())
+        without = engine._load_bank_uncached(db)
+    finally:
+        db.close()
+    assert with_defer and with_defer == without
-- 
