diff --git a/backend/app/services/ai/model_check.py b/backend/app/services/ai/model_check.py
new file mode 100644
index 0000000..dd86a1b
--- /dev/null
+++ b/backend/app/services/ai/model_check.py
@@ -0,0 +1,67 @@
+"""Daily check that every configured Gemini model still exists. Uses the models.get metadata call: no tokens are spent.
+
+A retired or misspelled model otherwise fails quietly (the prompt engine falls back to its regex path and quizzes just
+get worse). get_status() never blocks and never raises: it returns the last result and refreshes in the background.
+"""
+import logging
+import threading
+import time
+from typing import Any, Dict, Optional
+
+from backend.app.services.ai.model_config import models_in_use
+
+logger = logging.getLogger(__name__)
+_TTL_S = 24 * 3600
+_state: Dict[str, Any] = {"at": 0.0, "result": None, "running": False}
+_lock = threading.Lock()
+
+
+def _api_key() -> str:
+    from backend.app.config import settings
+    key = (getattr(settings, "GEMINI_API_KEY", None) or "").strip()
+    if len(key) > 1 and key[0] == key[-1] and key[0] in "\"'":
+        key = key[1:-1].strip()
+    return key
+
+
+def check_models(timeout_s: float = 5.0) -> Optional[Dict[str, Any]]:
+    key = _api_key()
+    if not key:
+        return None
+    from backend.app.services.prompt_quiz._http import get_client
+    out: Dict[str, Any] = {}
+    for role, model in models_in_use().items():
+        try:
+            r = get_client().get(f"https://generativelanguage.googleapis.com/v1beta/models/{model}",
+                                 headers={"x-goog-api-key": key}, timeout=timeout_s)
+            out[role] = {"model": model, "ok": r.status_code == 200, "status": r.status_code}
+            if r.status_code != 200:
+                logger.warning("Gemini model check: %s model %r returned HTTP %s", role, model, r.status_code)
+        except Exception as e:
+            out[role] = {"model": model, "ok": None, "error": type(e).__name__}
+    return out
+
+
+def _refresh() -> None:
+    try:
+        res = check_models()
+        with _lock:
+            _state["result"], _state["at"] = res, time.monotonic()
+    except Exception as e:
+        logger.warning("Gemini model check failed: %s", e)
+    finally:
+        with _lock:
+            _state["running"] = False
+
+
+def get_status() -> Optional[Dict[str, Any]]:
+    """Last known result (None before the first check finishes, or with no API key). Starts a refresh when it is stale."""
+    with _lock:
+        stale = time.monotonic() - _state["at"] > _TTL_S
+        start = stale and not _state["running"]
+        if start:
+            _state["running"] = True
+        result = _state["result"]
+    if start:
+        threading.Thread(target=_refresh, name="gemini-model-check", daemon=True).start()
+    return result
diff --git a/backend/app/services/ai/model_config.py b/backend/app/services/ai/model_config.py
new file mode 100644
index 0000000..c4a885e
--- /dev/null
+++ b/backend/app/services/ai/model_config.py
@@ -0,0 +1,41 @@
+"""One place that says which Gemini model each role uses.
+
+Every role resolves to the same value it did before (settings.GEMINI_MODEL, which defaults to gemini-3.5-flash-lite;
+the tagger and embedder keep their own settings). The optional GEMINI_MODEL_<ROLE> variables let one role be pointed
+at a different model later without touching code; all are unset by default.
+"""
+import os
+
+DEFAULT_MODEL = "gemini-3.5-flash-lite"
+EMBEDDING_MODEL = "gemini-embedding-001"
+
+
+def _settings():
+    from backend.app.config import settings
+    return settings
+
+
+def _role(env_name: str) -> str:
+    override = (os.getenv(env_name) or "").strip()
+    return override or (getattr(_settings(), "GEMINI_MODEL", None) or DEFAULT_MODEL)
+
+
+def interpreter_model() -> str:
+    return _role("GEMINI_MODEL_INTERPRETER")
+
+
+def intent_model() -> str:
+    return _role("GEMINI_MODEL_INTENT")
+
+
+def curator_model() -> str:
+    return _role("GEMINI_MODEL_CURATOR")
+
+
+def tagger_model() -> str:
+    return getattr(_settings(), "QSHALA_TAGGER_MODEL", None) or DEFAULT_MODEL
+
+
+def models_in_use() -> dict:
+    return {"interpreter": interpreter_model(), "intent": intent_model(), "curator": curator_model(),
+            "tagger": tagger_model(), "embedding": EMBEDDING_MODEL}
