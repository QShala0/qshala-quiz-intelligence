# QShala Quiz Intelligence Platform Environment Configuration

PROJECT_NAME="QShala Quiz Intelligence Platform"

# Database Configuration:
# For production PostgreSQL with pgvector:
# DATABASE_URL="postgresql+psycopg2://postgres:password@localhost:5432/qshala"
# For zero-configuration local development (automatic fallback):
DATABASE_URL="sqlite:///./backend/qshala.db"

# Data safety: the app refuses to boot on a non-persistent SQLite database by default (True).
# That's correct for every deployed environment (Render, Railway, etc) -- it's what stops a missing
# or flaky DATABASE_URL from silently losing the question vault on the next restart. Running the
# local SQLite fallback above requires explicitly opting out here:
REQUIRE_POSTGRES="False"

# AI Provider Configuration:
# Choose 'gemini', 'openai', or 'local'
LLM_PROVIDER="local"
EMBEDDING_PROVIDER="local"

# External API Keys (optional; if omitted, system runs on high-fidelity deterministic local engine)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Gemini model used for tagging/generation. Code default (if this is blank/unset) is
# gemini-3.5-flash-lite -- set it explicitly to keep it visible here too.
# Override here if Google renames/retires it later -- no code change needed.
GEMINI_MODEL="gemini-3.5-flash-lite"

# Hybrid tagging thresholds (cost control): the free rule-based tagger always runs first.
# A question only gets escalated to the Gemini API when its top keyword-match score is
# below TAGGING_CONFIDENCE_THRESHOLD, or when the runner-up topic is within
# TAGGING_AMBIGUITY_RATIO of the top score (i.e. it's a genuinely ambiguous call).
# Raise the threshold / lower the ratio to send MORE questions to Gemini (more accurate,
# more cost); lower/raise them to send fewer (cheaper, relies more on keyword matching).
TAGGING_CONFIDENCE_THRESHOLD=4.0
TAGGING_AMBIGUITY_RATIO=0.65

# Early-volume override: "true" sends EVERY question to Gemini, ignoring the
# confidence gate above entirely. Use this while ingestion volume is low (first
# few hundred questions) and accuracy matters more than API cost. Once you've
# accumulated enough Gemini-tagged questions to train your own local classifier
# (e.g. after a SharePoint bulk sync), set this to "false" to re-enable the
# cost-saving hybrid gate.
FORCE_AI_TAGGING="true"

# Vector & Validation Settings
EMBEDDING_DIM=768
DUPLICATE_SIMILARITY_THRESHOLD=0.85
MIN_GROUNDING_SCORE=0.70

# Cloudflare R2 Object Storage (optional). Media (slide images, audio, video) is
# stored locally on disk when these are left blank -- exactly like today. Fill
# these in to upload media to R2 instead (cheap storage, zero egress fees).
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_PUBLIC_BASE_URL=""  # e.g. https://pub-xxxxxxxx.r2.dev or your own custom domain

# Memory on Cloud Run (the disk is RAM). In a Cloud Run Job worker, auto = do not keep a second local copy of every
# extracted picture when R2 is on (vision downloads from R2 instead) and delete the local copy of the uploaded deck once
# it has been parsed (the R2 copy stays, so a retried task re-downloads it). 1/0 forces either; elsewhere auto = old behaviour.
# A retried task (Cloud Run retry / reaper requeue) first deletes the slides and questions its unfinished predecessor
# left on the document, so nothing is stored twice. Set 0 to keep the old behaviour. (Default: 1)
# RESET_PARTIAL_ON_RETRY=1
# Prompt-quiz question bank is cached this many seconds between requests (new/edited questions appear after that). 0 = off.
# PROMPT_QUIZ_BANK_TTL_S=10
# KEEP_LOCAL_MEDIA=auto
# DELETE_RAW_DECK_AFTER_PARSE=auto
# Pictures larger than 4 MP that may be decoded at the same time (each can take hundreds of MB). Default 1.
# BIG_DECODE_CONCURRENCY=1

# Optional shared-secret API gate (off by default -- leave blank to keep today's open behavior).
# Set this on the deployed backend, and set the matching NEXT_PUBLIC_API_KEY in the frontend's env
# (see frontend/.env.example), to stop anonymous visitors from uploading/deleting/burning quota.
# API_KEY_SECRET=""
# Fail closed: with REQUIRE_API_KEY=1, protected routes answer 503 when API_KEY_SECRET is unset, instead of
# serving anonymous callers. Set both on the Cloud Run service and the Job's service. (Default: off.)
# REQUIRE_API_KEY=1
# Frontend: put the key in the server-only BACKEND_API_KEY instead of NEXT_PUBLIC_API_KEY so it never reaches
# the browser; frontend/src/proxy.ts adds it to /api requests. NEXT_PUBLIC_API_KEY still works as a fallback.
# BACKEND_API_KEY=""

# Comma-separated list of allowed frontend origins. Required once deployed -- unset/blank falls
# back to localhost-only, NOT "*", so a deployed frontend can't reach the API until this is set.
# Example: CORS_ORIGINS="https://qshala.vercel.app,https://qshala-git-main-yourteam.vercel.app"
# CORS_ORIGINS=""

# Serial upload queue (opt-in; direct per-upload processing is the default and recommended path).
UPLOAD_QUEUE_ENABLED="False"
# Max number of decks ingesting concurrently when UPLOAD_QUEUE_ENABLED is on (default 1).
# 1 keeps decks processing strictly one at a time to prevent OOM on memory-constrained hosts.
INGESTION_MAX_CONCURRENCY=1

# QShala-domain tagger model override. Blank/unset falls back to gemini-3.5-flash-lite.
# QSHALA_TAGGER_MODEL=""

# Memory tuning for small hosts (512MB-1GB containers). Not read by the app itself -- these are
# process-level env vars read by the Python/glibc runtime -- but worth setting on whatever host
# replaces Render/Railway:
#   MALLOC_ARENA_MAX=2       caps glibc's per-thread memory arenas; the single most effective
#                            memory setting found for the ingestion pipeline on a small container.
#   VISION_CONCURRENCY=1     limits concurrent Gemini vision calls during deck ingestion.
# Also run with a single web worker (no --workers 2+): the upload queue's advisory lock and
# in-process state assume one process.

# Gemini cost controls (all optional; the defaults below are what the code uses when unset).
#   VISION_CONCURRENCY=12            image descriptions in flight at once (use 6 on a 512 MB-1 GB host)
#   VISION_MAX_OUTPUT_TOKENS=300     hard cap on one image description (a normal one is ~100 tokens)
#   VISION_THINKING_LEVEL=minimal    reasoning effort for image descriptions (hidden reasoning tokens are billed)
#   MAX_DESC_CHARS=1200              longest stored description per image (safety cap)
#   MAX_CLUES_CHARS=2400             longest stored visual_clues per question
#   EMBED_VISUAL_CLUES_CHARS=500     how much of visual_clues is embedded
#   QSHALA_TAG_CHUNK_SIZE=20         questions per tagging call
# NOTE: image descriptions run on GEMINI_MODEL (not QSHALA_TAGGER_MODEL). If your deployed GEMINI_MODEL is a
# larger model such as gemini-2.5-flash, every image is billed at that model's price.

# Gemini request concurrency for batch question tagging (separate from VISION_CONCURRENCY above,
# which is for image/vision calls). Default 8 assumes a paid-tier Gemini key with billing linked --
# drop this back down (e.g. 2) if running on the Gemini free tier, to avoid 429s.
# QSHALA_TAG_CHUNK_CONCURRENCY=8

# Soft memory-safety margin for ingestion, not a hard cap: crossing this logs one warning to the
# upload page's activity log so a deck approaching the container's real memory limit is visible
# before it ever gets there. Never aborts or throttles ingestion. Default 1792 MB = 1.75 GB,
# leaving ~256 MB of headroom below the 2048 MB the Cloud Run worker is given today -- raise it
# if the worker's memory allocation changes.
# MEMORY_WARN_THRESHOLD_MB=1792

# Where deck ingestion actually runs. "in_process" (default) is today's behavior -- zero change
# unless you set this. "cloud_run_job" offloads ingestion to a separate Cloud Run Job execution
# (backend/worker.py) per upload, so a heavy deck can't starve the API service's own request
# handling or exhaust its memory. Requires the three GCP_* vars below to also be set, and the API
# service's runtime service account needs run.jobs.run on the job (see deployment docs for the
# gcloud setup steps). Misconfigured (mode set but vars missing) fails the upload loudly rather
# than silently leaving it stuck at PENDING.
# INGESTION_MODE="cloud_run_job"
# GCP_PROJECT_ID=""
# GCP_REGION="asia-south1"
# INGESTION_JOB_NAME="qshala-ingestion-worker"

# --- Audit Phase 2: ingestion cost/speed switches (all optional; defaults shown) -------------------------
# Exact-repeat questions (same canonical question+answer hash as one already in the vault, or earlier in the
# same deck) are dropped by the deduplicator anyway, so by default they skip vision and embedding. Their
# repeat/provenance records are still written. Set 0 to restore the old order (AI first, then dedup).
# DEDUP_BEFORE_AI=1
# Vision reads the picture the parser just wrote to local disk instead of downloading it back from R2.
# Set 0 to always download.
# VISION_PREFER_LOCAL=1
# What to do with an uploaded deck that is byte-identical (SHA-256) to a deck already ingested:
#   process (default) = ingest as usual; the questions become "Repeated" entries on the originals.
#   skip              = mark it completed immediately with no questions and no AI/R2 work. The repeat records
#                       are NOT written for a skipped re-upload. Only decks ingested after the file_sha256
#                       column exists can be matched.
# IDENTICAL_REUPLOAD_ACTION=process

# Embedding failures. By default a text Gemini cannot embed (after retries, plus one more pass after a pause)
# is stored WITHOUT a vector, and a search whose query cannot be embedded falls back to keyword ranking for
# that request. Set 1 to restore the old behaviour of silently substituting a local hash vector, which sits in
# a different vector space from the stored Gemini vectors and degrades search and duplicate detection.
# EMBEDDING_ALLOW_LOCAL_FALLBACK=0
# EMBEDDING_RETRY_PASSES=1
# EMBEDDING_RETRY_DELAY_S=4

# Gemini request retries: 429/503 back off exponentially (2s, 4s, 8s ...) and wait at least as long as Google's
# Retry-After header; timeouts and dropped connections are retried the same way (a call that timed out on our
# side may still be billed, so each retry can cost one more call; set 0 to fail them immediately).
# GEMINI_RETRY_ON_TIMEOUT=1
# GEMINI_RETRY_AFTER_CAP_S=60
# GEMINI_RETRY_BACKOFF_CAP_S=30
# A batch-tagging chunk that takes longer than this is abandoned and its questions go to review. Must exceed the
# 90 s HTTP timeout of a single Gemini request.
# QSHALA_TAG_CHUNK_TIMEOUT_S=120

# Cloud Run Job mode: cancelling a deck whose worker refreshed its job row within this many seconds only sets the
# cancel flag (the worker stops and cleans up itself) instead of purging the document from under it. An older job
# is treated as dead and purged immediately.
# WORKER_ALIVE_WINDOW_S=90

# PPTX export fetches media from URLs stored with the questions. By default it only fetches http(s) URLs whose host
# resolves to a public address (never loopback, private, link-local or cloud-metadata addresses), and redirects are
# checked the same way. To restrict it to exactly your own media hosts, list them (comma separated):
# EXPORT_ALLOWED_MEDIA_HOSTS=pub-xxxxxxxx.r2.dev,media.example.com

# Format-aware ingestion (tournament decks): units are found from the ANSWER slides and each question's format
# (List It, Image Reveal, Connect, Stepped Clue, Arrange the Order, MCQ, plain Q&A) from the slide structure.
#   FORMAT_AWARE_INGESTION=1     default on. 0 = use the older round-number based extractor (quick rollback).
#   FORMAT_VISION_CHECK=0        default off. 1 = a reading with confidence 0.7-0.9 gets one small Gemini vision call
#                                that looks at the question's pictures; disagreement sends it to review.
#   FORMAT_VISION_MAX_CALLS=50   cap on those calls per deck.
# FORMAT_AWARE_INGESTION=1
# FORMAT_VISION_CHECK=0
# FORMAT_VISION_MAX_CALLS=50
