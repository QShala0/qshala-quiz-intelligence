# QShala frontend environment configuration

# Backend API base. If unset: falls back to /api/v1 in the browser (same-origin / proxy setups),
# or VERCEL_URL, or http://localhost:8000/api/v1 for local dev against a local backend.
# NEXT_PUBLIC_API_URL="https://your-backend-host.example.com/api/v1"

# Matches the backend's API_KEY_SECRET (see backend .env.example). Optional -- leave unset while
# API_KEY_SECRET is unset on the backend. Once the backend starts requiring the header, every
# request from this app needs the same value here or it will get 401s.
# NEXT_PUBLIC_API_KEY=""

# Uploads: how many slices of one file are sent at the same time (1 = one at a time, max 6). Default 3.
# NEXT_PUBLIC_UPLOAD_PARALLEL=3

# Voice input: address of our own voice service (voice_service/, faster-whisper on Cloud Run, region asia-southeast1).
# Used by the mic on browsers that have no working built-in recognition (Brave, Safari, Firefox).
# Set in Vercel for Production and Preview. If unset, the mic shows "Voice service not configured" in those browsers.
# NEXT_PUBLIC_VOICE_API_URL=https://qshala-voice-xxxxxxxx-as.a.run.app
